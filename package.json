{
  "name": "node-with-metrics",
  "version": "1.12.3",
  "description": "Node with Metrics",
  "exports": "./dist/index.js",
  "repository": "https://github.com/houstonj1/node-with-metrics",
  "author": "James Houston <james@houston.dev>",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "nodemon --exec node --import ./src/tracing.ts src/index.ts",
    "lint": "eslint src/**/*.ts --fix && prettier --write .",
    "lint:ci": "eslint src/**/*.ts --fix && prettier --check .",
    "start": "node --import ./dist/tracing.js dist/index.js",
    "test": "jest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@prometheus-io/client": "^0.16.1",
    "express": "^5.2.1"
  },
  "resolutions": {
    "glob": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
