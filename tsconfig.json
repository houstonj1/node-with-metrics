{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "alwaysStrict": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  "exclude": ["src/tests"],
  "include": ["src/**/*"]
}
